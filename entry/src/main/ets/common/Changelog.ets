/**
 * 更新日志数据源。
 *
 * 新增版本时在最前面插入一条即可，更新日志页按数组顺序渲染（最新在上）。
 * 版本号口径：app.json5 的 versionName，例如 2.0.3。
 */
export class ChangeLogEntry {
  /** 版本号 */
  version: string = '';
  /** 发布日期 */
  date: string = '';
  /** 该版本要点 */
  items: Array<string> = [];
  /** 是否当前版本（列表中高亮可展开的那个） */
  current: boolean = false;

  constructor(version: string, date: string, items: Array<string>, current: boolean = false) {
    this.version = version;
    this.date = date;
    this.items = items;
    this.current = current;
  }
}

